---
import { type CollectionEntry, getCollection, render } from 'astro:content';

import ContactCTA from '../../components/ContactCTA.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
	entry: CollectionEntry<'work'>;
}

// This is a dynamic route that generates a page for every Markdown file in src/content/
// Read more about dynamic routes and this `getStaticPaths` function in the Astro docs:
// https://docs.astro.build/en/guides/routing/#dynamic-routes
export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<div class="stack gap-20">
		<header class="project-header">
			<div class="wrapper stack gap-8">
				<a class="back-link" href="/work/"><Icon icon="arrow-left" /> Retour aux Projets</a>
				
				<div class="hero-wrapper">
					<Hero title={entry.data.title} align="start">
						<p class="description">{entry.data.description}</p>
					</Hero>
				</div>
			</div>
		</header>

		<main class="wrapper">
			<div class="project-layout">
				<aside class="project-sidebar">
					<div class="sidebar-card">
						<h3 class="sidebar-title">Technologies</h3>
						<div class="tags">
							{entry.data.tags.map((t) => <Pill>{t}</Pill>)}
						</div>
					</div>

					<div class="sidebar-card">
						<h3 class="sidebar-title">Détails</h3>
						<ul class="details-list">
							<li>
								<strong>Date :</strong> 
								{entry.data.publishDate ? new Date(entry.data.publishDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' }) : "En cours"}
							</li>
						</ul>
					</div>
				</aside>

				<article class="project-content content">
					<div class="markdown-content">
						<Content />
					</div>
				</article>
			</div>
		</main>
	</div>
</BaseLayout>

<style>
	.project-header {
		padding: 3rem 0 2rem;
		border-bottom: 1px solid var(--gray-800);
		background-color: var(--gray-999);
	}

	.hero-wrapper {
		margin-top: 2rem;
		max-width: 60ch;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 500;
		color: var(--gray-300);
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	.back-link:hover,
	.back-link:focus {
		color: var(--gray-0);
	}

	.description {
		font-size: var(--text-lg);
		color: var(--gray-200);
		line-height: 1.6;
		margin-top: 1.5rem;
	}

	.project-layout {
		display: flex;
		flex-direction: column-reverse;
		gap: 3rem;
		margin-top: 2rem;
	}

	.project-sidebar {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.sidebar-card {
		background: var(--gray-900);
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		padding: 1.5rem;
	}

	.sidebar-title {
		font-size: var(--text-md);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--gray-400);
		margin-bottom: 1rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.details-list {
		list-style: none;
		padding: 0;
		color: var(--gray-200);
		font-size: var(--text-base);
	}

	.details-list li {
		margin-bottom: 0.5rem;
	}

	.details-list strong {
		color: var(--gray-0);
	}

	.project-content {
		flex: 1;
	}

	.project-cover {
		width: 100%;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
		margin-bottom: 3rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
	}

	.markdown-content {
		color: var(--gray-200);
		line-height: 1.8;
	}

	.markdown-content :global(h1),
	.markdown-content :global(h2),
	.markdown-content :global(h3),
	.markdown-content :global(h4),
	.markdown-content :global(h5) {
		color: var(--gray-0);
		margin: 2.5rem 0 1rem;
	}

	.markdown-content :global(p) {
		margin-bottom: 1.5rem;
	}

	.markdown-content :global(ul),
	.markdown-content :global(ol) {
		margin-bottom: 1.5rem;
		padding-left: 1.5rem;
	}

	.markdown-content :global(li) {
		margin-bottom: 0.5rem;
	}

	.markdown-content :global(img) {
		border-radius: 1rem;
		box-shadow: var(--shadow-sm);
		border: 1px solid var(--gray-800);
		margin: 2rem 0;
	}

	.markdown-content :global(blockquote) {
		font-size: var(--text-lg);
		font-style: italic;
		line-height: 1.6;
		padding-left: 1.5rem;
		border-left: 4px solid var(--accent-regular);
		color: var(--gray-100);
		margin: 2rem 0;
	}

	.markdown-content :global(a) {
		color: var(--link-color);
		text-decoration: underline;
		transition: opacity var(--theme-transition);
	}

	.markdown-content :global(a:hover) {
		opacity: 0.8;
	}

	@media (min-width: 50em) {
		.project-layout {
			flex-direction: row;
			gap: 4rem;
			align-items: flex-start;
		}

		.project-sidebar {
			width: 300px;
			flex-shrink: 0;
			position: sticky;
			top: 2rem;
		}

		.markdown-content :global(blockquote) {
			font-size: var(--text-xl);
		}
	}
</style>
