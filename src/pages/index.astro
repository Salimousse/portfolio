---
import { getCollection } from 'astro:content';
// Component Imports
import CallToAction from '../components/CallToAction.astro';
// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Icon from '../components/Icon.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Content Fetching: List four most recent work projects
const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="custom-hero">
				<div class="hero-content">
					
					<h1 class="hero-title">
						Bonjour, je suis <span class="highlight">Salim</span><br />
						Je construis pour le web.
					</h1>
					<p class="hero-tagline">
						Étudiant en BTS SIO option SLAM, je suis développeur passionné par la création d'applications web et mobiles.
					</p>
					<div class="hero-actions">
						<a href="/work/" class="btn-primary">Voir mon travail <Icon icon="arrow-right" size="1.2em" /></a>
						<a href="/about/" class="btn-secondary">Me contacter</a>
						<a href="/Salim SETTOUTI.pdf" class="btn-link" target="_blank" rel="noopener noreferrer"><Icon icon="paper-plane-tilt" size="1.2em" /> CV</a>
					</div>
					<div class="tech-section">
						<h3 class="tech-title">TECHNOLOGIES</h3>
						<div class="tech-pills">
							<span class="tech-pill">HTML / CSS</span>
							<span class="tech-pill">JavaScript</span>
							<span class="tech-pill">PHP</span>
							<span class="tech-pill">SQL</span>
							<span class="tech-pill">Python</span>
							<span class="tech-pill">PowerShell</span>
							<span class="tech-pill">C# </span>
						</div>
					</div>
				</div>
				<div class="hero-image">
					<!-- Remplacez SRC par le bon chemin de votre photo -->
					<img src="/assets/photo-salim.jpg" alt="Portrait de Salim" />
				</div>
			</header>
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-background">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Mes Compétences Techniques</h3>
					<p>Un aperçu des langages, outils et applications que je maîtrise au quotidien.</p>
				</header>

				<div class="gallery">
					<div class="skills-grid">
						<div class="skill-category">
							<div class="skill-header">
								<Icon icon="code" color="var(--accent-regular)" size="2.5rem" gradient />
								<h4>Dév. Web & Apps</h4>
							</div>
							<ul>
								<li>
									<div class="skill-icons">
										<i class="devicon-html5-plain colored"></i>
										<i class="devicon-css3-plain colored"></i>
										<i class="devicon-tailwindcss-original colored"></i>
										<i class="devicon-bootstrap-plain colored"></i>
									</div>
									<span>HTML5/CSS (Tailwind, Bootstrap)</span>
								</li>
								<li>
									<div class="skill-icons">
										<i class="devicon-javascript-plain colored"></i>
										<i class="devicon-typescript-plain colored"></i>
									</div>
									<span>JavaScript / TypeScript</span>
								</li>
								<li>
									<div class="skill-icons">
										<i class="devicon-php-plain colored"></i>
										<i class="devicon-laravel-original colored"></i>
									</div>
									<span>PHP 8 (MVC/Laravel - ORM Eloquent)</span>
								</li>
								<li>
									<div class="skill-icons">
										<i class="devicon-vuejs-plain colored"></i>
										<i class="devicon-nodejs-plain colored"></i>
									</div>
									<span>VueJS, NodeJS, API REST</span>
								</li>
								<li>
									<div class="skill-icons">
										<i class="devicon-csharp-plain colored"></i>
										<i class="devicon-flutter-plain colored"></i>
									</div>
									<span>C# (MVC, EF), Flutter/Dart</span>
								</li>
							</ul>
						</div>

						<div class="skill-category">
							<div class="skill-header">
								<Icon icon="list" color="var(--accent-regular)" size="2.5rem" gradient />
								<h4>Bases de données</h4>
							</div>
							<ul>
								<li>
									<div class="skill-icons">
										<i class="devicon-mysql-plain colored"></i>
									</div>
									<span>MySQL / MariaDB, SQL</span>
								</li>
								<li>
									<div class="skill-icons">
										<i class="devicon-mongodb-plain colored"></i>
									</div>
									<span>MongoDB / NoSQL</span>
								</li>
								<li>Modélisation Merise / UML</li>
								<li>JSON</li>
							</ul>
						</div>

						<div class="skill-category">
							<div class="skill-header">
								<Icon icon="terminal-window" color="var(--accent-regular)" size="2.5rem" gradient />
								<h4>Systèmes, Réseaux & Sécu</h4>
							</div>
							<ul>
								<li>
									<div class="skill-icons">
										<i class="devicon-linux-plain"></i>
										<i class="devicon-windows8-original colored"></i>
									</div>
									<span>Linux / Windows, SSH, WSL2</span>
								</li>
								<li>
									<div class="skill-icons">
										<i class="devicon-docker-plain colored"></i>
									</div>
									<span>Docker, Sécurisation de serveurs</span>
								</li>
								<li>Méthodes OWASP, Tests d'intrusion</li>
								<li>Cert. SecNumacadémie</li>
							</ul>
						</div>

						<div class="skill-category">
							<div class="skill-header">
								<Icon icon="strategy" color="var(--accent-regular)" size="2.5rem" gradient />
								<h4>Gestion de projet</h4>
							</div>
							<ul>
								<li>Méthodes Agile</li>
								<li>
									<div class="skill-icons">
										<i class="devicon-trello-plain colored"></i>
									</div>
									<span>Trello, Diagrammes de Gantt</span>
								</li>
								<li>
									<div class="skill-icons">
										<i class="devicon-git-plain colored"></i>
										<i class="devicon-gitlab-plain colored"></i>
									</div>
									<span>Git / GitLab</span>
								</li>
							</ul>
						</div>
					</div>
				</div>

				<div class="cta">
					<CallToAction href="/about/">
						En savoir plus sur mon parcours
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			
		</main>
	</div>
</BaseLayout>

<style>
	/* Custom Hero Styles */
	.custom-hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
		max-width: 1000px;
		margin: 0 auto;
		padding: 4rem 1rem;
	}

	@media (min-width: 50em) {
		.custom-hero {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
			padding: 6rem 1rem;
		}
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 2rem;
		flex: 1;
	}

	.hero-image {
		flex-shrink: 0;
		width: 250px;
		height: 250px;
	}

	.hero-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
		border: 4px solid #eab308;
		box-shadow: 0 10px 30px rgba(234, 179, 8, 0.2);
	}

	@media (min-width: 50em) {
		.hero-image {
			width: 320px;
			height: 320px;
		}
	}

	/* Skills Grid Section */
	.skills-grid {
		display: grid;
		grid-auto-rows: 1fr;
		gap: 1.5rem;
		grid-template-columns: 1fr;
		width: 100%;
	}

	@media (min-width: 50em) {
		.skills-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 70em) {
		.skills-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.skill-category {
		background: var(--gray-999);
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		padding: 2rem;
		box-shadow: var(--shadow-sm);
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		transition: transform 0.3s ease, border-color 0.3s ease;
		height: 100%;
	}

	.skill-category:hover {
		transform: translateY(-5px);
		border-color: var(--accent-regular);
	}

	.skill-header {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
		text-align: center;
	}

	.skill-header h4 {
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.skill-category ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.8rem;
		color: var(--gray-300);
	}

	.skill-category ul li {
		padding: 0.5rem 1rem;
		background: var(--gray-900);
		border-radius: 999px; /* Aspect pilule comme les tags de projets */
		text-align: center;
		font-weight: 500;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--text-sm);
	}

	.skill-icons {
		display: flex;
		gap: 0.25rem;
		font-size: 1.1rem;
	}

	.availability-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background-color: rgba(234, 179, 8, 0.1);
		border: 1px solid #eab308;
		color: #eab308;
		border-radius: 9999px;
		font-size: var(--text-sm);
		font-weight: 500;
	}

	.hero-title {
		font-size: 3.5rem;
		line-height: 1.1;
		font-weight: 800;
		color: var(--gray-0);
		margin: 0;
	}

	.highlight {
		color: #eab308;
	}

	.hero-tagline {
		font-size: 1.125rem;
		color: var(--gray-300);
		line-height: 1.6;
		max-width: 65ch;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		align-items: center;
	}

	.btn-primary, .btn-secondary, .btn-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		border-radius: 0.5rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease-in-out;
	}

	.btn-primary {
		background-color: transparent;
		color: #eab308;
		border: 1px solid #eab308;
	}
	.btn-primary:hover {
		background-color: rgba(234, 179, 8, 0.1);
	}

	.btn-secondary {
		background-color: var(--gray-800);
		border: 1px solid var(--gray-700);
		color: var(--gray-0);
	}
	.btn-secondary:hover {
		background-color: var(--gray-700);
	}

	.btn-link {
		color: var(--gray-200);
		padding: 0.75rem 1rem;
	}
	.btn-link:hover {
		color: var(--gray-0);
	}

	.tech-section {
		margin-top: 3rem;
		width: 100%;
		border-top: 1px solid var(--gray-800);
		padding-top: 2rem;
	}

	.tech-title {
		font-size: 0.875rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--gray-500);
		margin-bottom: 1.5rem;
	}

	.tech-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.tech-pill {
		padding: 0.25rem 1rem;
		background-color: var(--gray-900);
		border: 1px solid var(--gray-800);
		color: var(--gray-200);
		border-radius: 9999px;
		font-size: 0.875rem;
	}

	@media (min-width: 50em) {
		.hero-title {
			font-size: 5rem;
		}
		.custom-hero {
			padding: 8rem 2.5rem;
		}
	}

	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero img {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}

	/* ====================================================== */

	.mention-card {
		display: flex;
		height: 7rem;
		justify-content: center;
		align-items: center;
		text-align: center;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		color: var(--gray-300);
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	@media (min-width: 50em) {
		.mention-card {
			border-radius: 1.5rem;
			height: 9.5rem;
		}
	}
</style>
