---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Contact | Salim SETTOUTI" description="Me contacter - Salim SETTOUTI">
	<div class="stack gap-20">
		<main class="wrapper contact-page">
			<Hero
				title="Contact"
				tagline="N'hésitez pas à me contacter pour toute demande."
			/>

			<div class="contact-container">
				<!-- Formulaire de contact -->
				<section class="form-section">
					<h3>Envoyez-moi un message</h3>
					<form class="contact-form" action="https://formspree.io/f/mrejryyn" method="POST">
						<div class="form-group">
							<label for="name">Nom / Prénom</label>
							<input type="text" id="name" name="name" required placeholder="Votre nom" />
						</div>
						<div class="form-group">
							<label for="email">Adresse Email</label>
							<input type="email" id="email" name="email" required placeholder="votre.email@exemple.com" />
						</div>
						<div class="form-group">
							<label for="message">Votre Message</label>
							<textarea id="message" name="message" rows="6" required placeholder="Bonjour Salim..."></textarea>
						</div>
						<button type="submit" class="submit-btn">
							Envoyer le message
							<Icon icon="paper-plane-tilt" size="1.2em" />
						</button>
					</form>
				</section>

				<!-- Informations de contact (LinkedIn, etc.) -->
				<div class="contact-methods stack gap-8">
					<section class="contact-card">
						<div class="icon-wrapper">
							<Icon icon="linkedin-logo" size="2.5em" />
						</div>
						<h2>Sur LinkedIn</h2>
						<p>Retrouvez mon profil professionnel ou envoyez-moi un message :</p>
						<a class="contact-link" href="https://www.linkedin.com/in/salim-settouti-22b696350/" target="_blank" rel="noopener noreferrer">Mon Profil LinkedIn</a>
					</section>

					<section class="contact-card">
						<div class="icon-wrapper">
							<Icon icon="paper-plane-tilt" size="2.5em" />
						</div>
						<h2>Par Email</h2>
						<a class="contact-link" href="mailto:settoutisalim@yahoo.fr">settoutisalim@yahoo.fr</a>
					</section>
					
					<section class="contact-card">
						<div class="icon-wrapper">
							<Icon icon="github-logo" size="2.5em" />
						</div>
						<h2>Sur GitHub</h2>
						<a class="contact-link" href="https://github.com/Salimousse" target="_blank" rel="noopener noreferrer">Mes Projets</a>
					</section>
				</div>
			</div>
		</main>
	</div>
</BaseLayout>

<style>
	.contact-page {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		padding-bottom: 5rem;
	}

	.contact-container {
		display: grid;
		gap: 3rem;
		margin-top: 2rem;
	}

	@media (min-width: 50em) {
		.contact-container {
			grid-template-columns: 3fr 2fr;
			align-items: start;
		}
	}

	/* Formulaire */
	.form-section {
		background-color: var(--gray-999_40);
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		padding: 2.5rem;
		box-shadow: var(--shadow-sm);
	}

	.form-section h3 {
		font-size: var(--text-2xl);
		margin-bottom: 2rem;
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.form-group label {
		color: var(--gray-200);
		font-weight: 500;
	}

	.form-group input,
	.form-group textarea {
		padding: 1rem;
		border-radius: 0.5rem;
		border: 1px solid var(--gray-700);
		background-color: var(--gray-900);
		color: var(--gray-100);
		font-family: var(--font-body);
		font-size: var(--text-md);
		transition: border-color 0.2s ease;
	}

	.form-group input:focus,
	.form-group textarea:focus {
		outline: none;
		border-color: var(--accent-regular);
	}

	.submit-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.8rem;
		padding: 1rem;
		border: none;
		border-radius: 999rem;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		font-size: var(--text-lg);
		font-weight: 600;
		font-family: inherit;
		cursor: pointer;
		transition: background-color 0.2s ease;
		margin-top: 1rem;
	}

	.submit-btn:hover {
		background: var(--accent-dark);
	}

	/* Cartes latérales */
	.contact-methods {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.contact-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 2rem 1.5rem;
		background-color: var(--gray-999_40);
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.contact-card:hover {
		transform: translateY(-5px);
		box-shadow: var(--shadow-md);
	}

	.icon-wrapper {
		color: var(--accent-regular);
		margin-bottom: 1rem;
		background: var(--gradient-accent-orange);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.contact-card h2 {
		font-size: var(--text-lg);
		margin-bottom: 0.5rem;
	}

	.contact-card p {
		color: var(--gray-300);
		margin-bottom: 1.5rem;
		font-size: var(--text-sm);
	}

	.contact-link {
		font-size: var(--text-md);
		font-weight: 600;
		color: var(--accent-text-over);
		text-decoration: none;
		padding: 0.5rem 1rem;
		background: var(--accent-regular);
		border-radius: 999rem;
		transition: background-color 0.2s ease;
	}

	.contact-link:hover {
		background: var(--accent-dark);
	}
</style>